# Pulse lead scraper - environment configuration
# Copy to .env (gitignored) and fill in your keys.

# ── Required baseline ─────────────────────────────────────
CONTACT_EMAIL=you@yourdomain.com
TARGET_LEADS=200
SCRAPE_CONCURRENCY=6

# Quality-only mode: ignore TARGET_LEADS, only ship rows where Invisalign
# is STRONG on own site AND (scraped owner email OR Apollo confirms direct
# dial), OR hiring_receptionist is yes (always passes). Recommended for
# cold outreach; you'll get a smaller, dialable list rather than 200
# pattern-guesses.
QUALITY_MODE=1

# ── Discovery sources ─────────────────────────────────────
# Google Places (New) - https://console.cloud.google.com -> enable Places API (New)
GOOGLE_PLACES_API_KEY=

# Companies House (free) - https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# ── Apollo (owner identity + hiring signal, FREE via Search) ───────
# People Search does NOT consume credits per Apollo docs.
# Enrichment burns credits and only runs in calibration mode.
APOLLO_API_KEY=

# When `npm run leads:calibrate` is run, this many Apollo Enrichments
# are purchased for side-by-side comparison vs homegrown. Set to 0 to skip.
APOLLO_CALIBRATION_SAMPLE_SIZE=10

# ── Google Drive upload ─────────────────────────────────────
GDRIVE_UPLOAD=0

# Drive folder ID (from the URL of the folder you want to upload into).
GDRIVE_FOLDER_ID=

# AUTH OPTION A: Service account (CI / headless / phone-driven workflow).
# Paste the FULL JSON key as a single line. The pipeline will prefer this
# over OAuth Desktop when set.
GDRIVE_SERVICE_ACCOUNT_JSON=

# AUTH OPTION B: OAuth Desktop client (laptop, interactive first-run auth).
# Only used if GDRIVE_SERVICE_ACCOUNT_JSON is empty.
GDRIVE_CREDENTIALS_PATH=
GDRIVE_TOKEN_PATH=
