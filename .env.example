# Pulse lead scraper - environment configuration
# Copy to .env (gitignored) and fill in your keys.

# ── Required baseline ─────────────────────────────────────
CONTACT_EMAIL=you@yourdomain.com
TARGET_LEADS=200
SCRAPE_CONCURRENCY=6
QUALITY_MODE=1

# ── Discovery sources ─────────────────────────────────────
GOOGLE_PLACES_API_KEY=
COMPANIES_HOUSE_API_KEY=

# ── Apollo (owner identity + hiring signal) ────────────────────────
APOLLO_API_KEY=
APOLLO_CALIBRATION_SAMPLE_SIZE=10
MAX_APOLLO_CREDITS_PER_RUN=100

# ── Drafting agent (Claude) ───────────────────────────────────
# Required for `npm run leads:draft-outreach`. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: override the draft model.
# PULSE_DRAFT_MODEL=claude-sonnet-4-6

# ── Google Drive upload ─────────────────────────────────────
GDRIVE_UPLOAD=0
GDRIVE_FOLDER_ID=

# OAuth refresh token (PREFERRED for personal Drive uploads)
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=

# Service account (only works with Workspace Shared Drives)
GDRIVE_SERVICE_ACCOUNT_JSON=

# OAuth Desktop fallback for local interactive auth
GDRIVE_CREDENTIALS_PATH=
GDRIVE_TOKEN_PATH=

# ── Gmail Drafts (OPTIONAL) ───────────────────────────────────
# If set, the drafting agent places drafts directly in your Gmail Drafts
# folder instead of writing a Google Sheet. Requires the gmail.compose
# scope on the refresh token — redo the OAuth Playground walkthrough with
# both scopes (drive.file + gmail.compose) to enable.
# You can reuse the same client_id/secret as Drive; the playground will
# emit a single refresh token that covers both scopes.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Optional: override the From header on Gmail drafts (defaults to your account).
GMAIL_FROM_EMAIL=
