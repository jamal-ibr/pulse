# Pulse lead scraper - environment configuration
# Copy to .env (gitignored) and fill in your keys.

# ── Required baseline ─────────────────────────────────────
CONTACT_EMAIL=you@yourdomain.com
TARGET_LEADS=200
SCRAPE_CONCURRENCY=6

# ── Discovery sources ─────────────────────────────────────
# Google Places (New) - https://console.cloud.google.com -> enable Places API (New)
GOOGLE_PLACES_API_KEY=

# Companies House (free) - https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# ── Apollo (owner identity + hiring signal, FREE via Search) ───────
# People Search does NOT consume credits per Apollo docs.
# Enrichment burns credits and only runs in calibration mode.
# https://app.apollo.io -> Settings -> API
APOLLO_API_KEY=

# When `npm run leads:calibrate` is run, this many Apollo Enrichments
# are purchased for side-by-side comparison vs homegrown. Set to 0 to skip.
APOLLO_CALIBRATION_SAMPLE_SIZE=10

# ── Google Drive upload (OAuth Desktop) ──────────────────────────
# Set to 1 to upload outreach CSV + a Google Sheet to your Drive after each run.
GDRIVE_UPLOAD=0

# Optional: upload into a specific folder. Find the ID in the Drive folder URL
# (e.g. https://drive.google.com/drive/folders/<ID>). Leave blank for Drive root.
GDRIVE_FOLDER_ID=

# Path to OAuth client JSON (download from Google Cloud Console).
# Defaults to scripts/scrape-leads/.gdrive/credentials.json (gitignored).
GDRIVE_CREDENTIALS_PATH=

# Where to cache the access token after first browser auth.
# Defaults to scripts/scrape-leads/.gdrive/token.json (gitignored).
GDRIVE_TOKEN_PATH=
