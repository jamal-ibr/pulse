# Jamal OS environment configuration
# Copy this file to .env.local and fill in values.
# .env.local is gitignored. Never commit secrets.

# Optional. If absent, all AI features use the deterministic mock provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local SQLite database path. Default is data/jamal-os.db relative to jamal-os/.
DATABASE_URL=data/jamal-os.db

# Used to encrypt OAuth tokens at rest once real connectors are implemented.
# Generate with: openssl rand -hex 32
LOCAL_ENCRYPTION_KEY=

# Google OAuth placeholders. Only needed for real Gmail (read-only) and
# Google Calendar connectors. See SETUP.md for setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
