# Jamal OS environment configuration
# Copy this file to .env.local and fill in values.
# .env.local is gitignored. Never commit secrets.

# Optional. If absent, all AI features use the deterministic mock provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local SQLite database path. Default is data/jamal-os.db relative to jamal-os/.
DATABASE_URL=data/jamal-os.db

# Required before connecting Gmail. Encrypts OAuth tokens at rest.
# Generate with: openssl rand -hex 32
LOCAL_ENCRYPTION_KEY=

# Google OAuth keys for the Gmail (read-only) connector, and later
# Google Calendar. See SETUP.md for the step-by-step setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Shared secret for the Apple Health ingest endpoint (Health Auto Export
# app on the iPhone POSTs here). Generate with: openssl rand -hex 16
HEALTH_INGEST_TOKEN=

# Monzo OAuth keys for the read-only bank feed. See SETUP.md.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=http://localhost:3000/api/oauth/monzo/callback
