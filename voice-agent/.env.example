# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
# Model used for both conversation and extraction.
# Verify the current model string at https://platform.claude.com/docs/en/about-claude/models/overview
# Recommended: claude-opus-4-8 (best quality). For the lowest time-to-first-audio
# on voice calls you can set claude-haiku-4-5 instead.
CLAUDE_MODEL=

# --- Retell ---
RETELL_API_KEY=
# Used to verify signatures on POST /retell/webhook (x-retell-signature header).
# TODO: confirm the exact verification scheme against current Retell docs.
RETELL_WEBHOOK_SECRET=

# --- Workflow webhooks (n8n recommended; Make.com/Zapier work identically) ---
# In n8n: create a workflow starting with a Webhook node (method POST),
# activate it, and paste the PRODUCTION webhook URL here.
# Returns busy calendar blocks so the agent can offer and confirm real
# appointment times. Without it the agent still runs, but only takes
# preferences instead of confirming. n8n workflow must reply with:
#   { "busy": [ { "start": "<ISO>", "end": "<ISO>" } ] }
AVAILABILITY_WEBHOOK_URL=
LEAD_WEBHOOK_URL=
BOOKING_WEBHOOK_URL=
STAFF_ALERT_WEBHOOK_URL=
CALL_SUMMARY_WEBHOOK_URL=
# Legacy aliases (still supported): MAKE_LEAD_WEBHOOK_URL etc.
