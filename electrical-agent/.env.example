# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Business identity (appears in the greeting and the prompt) ---
BUSINESS_NAME=
# e.g. BUSINESS_NAME=Bright Spark Electrical
OWNER_NAME=
# e.g. OWNER_NAME=Steve

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
# Verify the current model string at
# https://platform.claude.com/docs/en/about-claude/models/overview
# Leave blank to use claude-opus-4-8. For the fastest possible replies on a
# voice line, try claude-haiku-4-5 and pick by ear.
CLAUDE_MODEL=

# --- Retell ---
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

# --- Emergency escalation ---
# The number a live call is transferred to for genuine emergencies, in
# E.164 format (e.g. +447700900123). Leave blank to disable live transfer -
# the agent will then take details and fire an urgent alert instead.
OWNER_TRANSFER_NUMBER=
# Set true to only attempt live transfer during working hours.
TRANSFER_WORKING_HOURS_ONLY=false

# How many engineers can be on jobs simultaneously. An arrival window stays
# bookable until this many jobs overlap it.
ENGINEER_CAPACITY=3

# --- Workflow webhooks (n8n) ---
# Availability must reply with: { "busy": [ { "start": "<ISO>", "end": "<ISO>" } ] }
# Without it the agent still runs, but takes preferences instead of confirming.
AVAILABILITY_WEBHOOK_URL=
LEAD_WEBHOOK_URL=
JOB_BOOKING_WEBHOOK_URL=
URGENT_ALERT_WEBHOOK_URL=
CALL_SUMMARY_WEBHOOK_URL=
